base.sql (ETU1)

créer base bngrc

créer table region(id, nom)

créer table ville(id, nom, id_region)

créer table categorie(id, nom)

créer table type_don(id, nom, id_categorie)

créer table besoin(id, id_ville, id_type_don, quantite, date_saisie)

créer table don(id, id_type_don, quantite, date_saisie)

créer table dispatch(id, id_don, id_ville, quantite_attribuee, date_dispatch)

insérer données test

